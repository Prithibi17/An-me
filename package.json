{
  "name": "an-me-desktop",
  "version": "1.0.3",
  "description": "An:me Desktop Client - Electron clone of An:me anime discovery & streaming application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "start": "electron .",
    "test": "node --experimental-strip-types --test tests/latestEpisodes.test.mjs tests/intelligentSearch.test.mjs tests/watchProgress.test.mjs tests/titleHelper.test.mjs tests/multiSourceAvailability.test.mjs",
    "package:win": "npm run build && electron-packager . \"An-me\" --platform=win32 --arch=x64 --out=dist-packages/win --overwrite --asar --icon=public/anme-icon.ico --ignore=\"^/(src|tests|scratch|dist-setup|dist-bin|dist-packages|\\.git)\"",
    "package:setup": "npm run build && electron-packager . \"An-me Setup\" --platform=win32 --arch=x64 --out=dist-setup --overwrite --asar --icon=public/anme-icon.ico --ignore=\"^/(src|tests|scratch|dist-setup|dist-bin|dist-packages|\\.git)\"",
    "package:linux": "electron-packager . \"An-me\" --platform=linux --arch=x64 --out=dist-packages/linux --overwrite --asar --ignore=\"^/(src|tests|scratch|dist-setup|dist-bin|dist-packages|\\.git)\"",
    "package:mac": "electron-packager . \"An-me\" --platform=darwin --arch=x64,arm64 --out=dist-packages/mac --overwrite --asar --ignore=\"^/(src|tests|scratch|dist-setup|dist-bin|dist-packages|\\.git)\"",
    "dist": "npm run package:win && npm run package:setup"
  },
  "keywords": [
    "anime",
    "electron",
    "desktop",
    "streaming",
    "anilist"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-packager": "^17.1.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
